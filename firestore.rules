rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /stories/{storyId} {
      allow read: if true; 
      
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(data) {
        return isSignedIn() && data.authorId == request.auth.uid;
      }

      function isValidStory(data) {
        return data.title is string && data.title.size() <= 200
            && data.pages is list
            && data.type in ['kid-story', 'visual-novel', 'training-video'];
      }

      allow create: if isSignedIn() && isValidStory(request.resource.data) && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data) && isValidStory(request.resource.data) && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner(resource.data);
    }
  }
}
